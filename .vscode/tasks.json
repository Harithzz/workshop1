{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build active file",
            "command": "cl.exe",
            "args": [
                "/EHsc",
                "/Fe${workspaceFolder}\\bin\\app.exe",
                "${workspaceFolder}\\src\\*.cpp",
                "/IC:\\mysql-connector-c++-9.7.0-winx64\\mysql-connector-c++-9.7.0-winx64\\include",
                "/link",
                "/LIBPATH:C:\\mysql-connector-c++-9.7.0-winx64\\mysql-connector-c++-9.7.0-winx64\\lib64\\vs14",
                "mysqlcppconn.lib"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$msCompile"],
            "group": { "kind": "build", "isDefault": true }
        }
    ]
}